# 服务监听地址。本机调试用 127.0.0.1；需要让局域网其他机器访问时改成 0.0.0.0。
AUTO_FIXER_HOST=127.0.0.1

# 服务监听端口。当前主要用于健康检查和任务状态查询。
AUTO_FIXER_PORT=8787

# 服务本地数据目录，用来保存 SQLite 状态库、仓库缓存、worktree。
AUTO_FIXER_DATA_DIR=.auto-fixer

# 轮询禅道 Bug 的间隔，单位秒。例如 120 表示每 2 分钟检查一次。
AUTO_FIXER_POLL_INTERVAL_SECONDS=120

# 后台修复 worker 数量。不同 Git 仓库可以并行；同一个仓库内部仍然串行。
AUTO_FIXER_WORKERS=2
# 每天最多允许多少次 AI 调用（一批 Bug 算一次），防止轮询异常导致连环烧钱
AUTO_FIXER_MAX_AGENT_RUNS_PER_DAY=100

# git clone/fetch/push 等单个命令超时，单位秒。
AUTO_FIXER_GIT_TIMEOUT_SECONDS=1800

# 首次 clone 默认只拉目标分支浅克隆，能明显减少第一次同步时间。
AUTO_FIXER_GIT_SHALLOW_CLONE=1

# 多项目映射配置文件。复制 projects.example.json 后按实际禅道产品和 Git 仓库填写。
AUTO_FIXER_PROJECTS_FILE=projects.json

# Codex CLI 路径。默认使用 PATH 里的 codex；如果服务进程找不到 codex，可以填绝对路径，例如 /opt/homebrew/bin/codex。
AUTO_FIXER_CODEX_BIN=codex
# 用 claude 引擎的项目走这个可执行文件（projects.json 里 agent=claude）
AUTO_FIXER_CLAUDE_BIN=claude

# Codex 因网络重连、turn interrupted 等非零退出时，在同一个 worktree 内最多重试次数。
AUTO_FIXER_CODEX_ATTEMPTS=3

# Codex 重试间隔，单位秒。
AUTO_FIXER_CODEX_RETRY_DELAY_SECONDS=15

# Codex 单次执行最长时间，单位秒。默认 1800 表示 30 分钟；设为 0 表示不限制。
# 超时后服务会终止 codex exec 及其子进程，释放同仓库队列，随后按 AUTO_FIXER_CODEX_ATTEMPTS 决定是否重试。
AUTO_FIXER_CODEX_TIMEOUT_SECONDS=1800

# zentao-bug-fixer skill 自带的禅道 API helper 路径。
# 留空、xxx、default、auto 都会使用 ~/.codex/skills/zentao-bug-fixer/scripts/zentao_client.py。
AUTO_FIXER_ZENTAO_CLIENT=auto

# 当 Python urllib 访问禅道 HTTPS 失败时，轮询阶段自动 fallback 到 curl。
AUTO_FIXER_ZENTAO_CURL_FALLBACK=1

# curl 访问禅道时默认强制 HTTP/1.1，通常能避开部分自部署 HTTPS 兼容问题。
AUTO_FIXER_ZENTAO_CURL_HTTP1=1

# 只有在自签证书或证书链异常时才设为 1；会关闭 curl 证书校验。
AUTO_FIXER_ZENTAO_CURL_INSECURE=0

# 轮询禅道 Bug 列表时单页数量。
AUTO_FIXER_ZENTAO_PAGE_LIMIT=200

# GitLab 认证不通过 API token 配置；直接使用 projects.json 里的 repoUrl。
# SSH repoUrl 需要本机已配置 SSH key；HTTPS repoUrl 需要本机 git credential 可用。

# 自动提交时使用的作者信息。
GIT_AUTHOR_NAME=Zentao Auto Fixer
GIT_AUTHOR_EMAIL=zentao-auto-fixer@example.com

# 自动提交时使用的 committer 信息；通常和作者一致即可。
GIT_COMMITTER_NAME=Zentao Auto Fixer
GIT_COMMITTER_EMAIL=zentao-auto-fixer@example.com

# 自部署禅道根地址。
ZENTAO_BASE_URL=https://zentao.xxx

# 自动修复失败后是否允许下一轮自动重试。默认 0，避免同一个 Bug 反复创建分支或消耗 Codex。
AUTO_FIXER_RETRY_FAILED=0

# 禅道账号密码。也可以不填账号密码，改用 ZENTAO_TOKEN。
ZENTAO_ACCOUNT=
ZENTAO_PASSWORD=

# 禅道 REST API 前缀。大多数新版禅道是 /api.php/v1。
ZENTAO_API_PREFIX=/api.php/v1

# 服务在批次 commit/push 成功后批量解决 Bug 时使用的 resolvedBuild。
ZENTAO_RESOLVED_BUILD=主干

# 建议保持 0。批次模式下 Codex 子进程只写备注；外层服务会在整批 push 成功后统一调用 resolve。
ZENTAO_RESOLVE_BUG_AFTER_COMMENT=0
